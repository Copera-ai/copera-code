# COPERA: Copera Code Windows packaging settings. See copera/docs/signing.md.
# Every Windows package reads this file, unsigned ones included: copy it to .env.windows (Git ignored) unchanged for
# `pnpm run package:desktop:win:x64:unsigned`, and fill in the signing section for a signed build.
# Use UTF-8 and quote values containing # or spaces. Credential file paths may be absolute or relative to apps/desktop.
# Values are not shell-expanded. Only the names below are accepted; any other name in .env.windows stops packaging.
# The shell environment never supplies these settings; packaging drops ambient DSH_DESKTOP_*, CSC_* and WIN_CSC_* values.

# ── Identity ─────────────────────────────────────────────────────────────────
# Leave unset: the application ID is ai.copera.code (apps/desktop/scripts/product-identity.mjs).
# Set only to give a test install its own reverse-DNS identity.
# DSH_DESKTOP_APP_ID=

# ── Auto-update ──────────────────────────────────────────────────────────────
# Always on for signed builds: packaging embeds the production feed https://desktop.copera.io/copera-code/<target>/
# on the stable channel and ignores DSH_DESKTOP_UPDATES, DSH_DESKTOP_AUTO_UPDATE_ENV and DSH_DESKTOP_UPDATE_CHANNEL.
# Unsigned builds embed no feed. Copera Code has no mandatory-update policy service, so no policy setting is needed.

# ── Build tuning (optional) ──────────────────────────────────────────────────
# npm registry for the bundled runtime install; defaults to https://registry.npmjs.org/.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmjs.org/
# Workspace tarball workers; a positive integer, 4 when unset.
# DSH_DESKTOP_WINDOWS_PACK_CONCURRENCY=4
# Installer archive compression (0-9); lower values trade size for packaging time.
DSH_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3

# ── Code signing (required for signed builds; leave empty for unsigned builds) ─
# Public leaf certificate file of the EV code-signing certificate (CN, O and C each present once).
DSH_DESKTOP_WINDOWS_CER_FILE=
# SafeNet-compatible signtool.exe.
DSH_DESKTOP_WINDOWS_SIGNTOOL=
# SafeNet private-key container name; no quotes or line breaks.
DSH_DESKTOP_WINDOWS_KEY_CONTAINER=
# SafeNet token password; no ], quotes or line breaks. Stored in plain text: restrict access to .env.windows.
DSH_DESKTOP_WINDOWS_TOKEN_PIN=
# Optional absolute private directory; defaults to %USERPROFILE%\.dsh-desktop-signing\signature-cache\v1.
# DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
# Cache-hit restore and verification workers (1-8). Hardware signing remains serial.
DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
