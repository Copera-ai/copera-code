# COPERA: Copera Code macOS packaging settings. See copera/docs/signing.md.
# Release configuration only: `pnpm run package:desktop:mac:*:unsigned` ignores this file entirely and needs nothing.
# Copy to .env.macos (Git ignored) for a signed build. Use UTF-8 and quote values containing # or spaces.
# Paths may be absolute or relative to apps/desktop. Values are not shell-expanded.
# Only the names below are accepted; any other name in .env.macos stops packaging.
# The shell environment never supplies these settings; packaging drops ambient DSH_DESKTOP_*, APPLE_* and CSC_* values.

# ── Identity ─────────────────────────────────────────────────────────────────
# Leave unset: the application ID is ai.copera.code (apps/desktop/scripts/product-identity.mjs).
# Set only to give a test install its own reverse-DNS identity.
# DSH_DESKTOP_APP_ID=

# ── Auto-update ──────────────────────────────────────────────────────────────
# Always on for signed builds: packaging embeds the production feed https://desktop.copera.io/copera-code/<target>/
# on the stable channel and ignores DSH_DESKTOP_UPDATES, DSH_DESKTOP_AUTO_UPDATE_ENV and DSH_DESKTOP_UPDATE_CHANNEL.
# Unsigned builds embed no feed. Copera Code has no mandatory-update policy service, so no policy setting is needed.

# ── Build tuning (optional) ──────────────────────────────────────────────────
# npm registry for the bundled runtime install; defaults to https://registry.npmjs.org/.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmjs.org/
# Workspace tarball workers; a positive integer, 4 when unset.
DSH_DESKTOP_MACOS_PACK_CONCURRENCY=4
# ZIP compression for the signed ZIP artifact: 3 or 7.
DSH_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
# Optional absolute private directory reused between signed builds to skip re-signing unchanged binaries.
# DSH_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
# Optional HTTP/HTTPS proxy origin for Electron, runtime assets, pnpm and builder downloads; empty keeps inherited networking.
DSH_DESKTOP_MACOS_DOWNLOAD_PROXY=
# Optional HTTP proxy temporarily applied to the active macOS network service during notarization (needs permission
# to change system proxies and affects other applications meanwhile); empty disables it.
DSH_DESKTOP_MACOS_NOTARIZATION_PROXY=

# ── Code signing (required for signed builds) ───────────────────────────────
# Certificate name without the "Developer ID Application:" prefix, for example: Example Company (TEAMID1234)
DSH_DESKTOP_MACOS_SIGNING_IDENTITY=
# Apple Team ID: 10 uppercase letters or digits.
DSH_DESKTOP_MACOS_TEAM_ID=
# Local .p12 holding the Developer ID Application certificate and its private key (no URL, no Base64).
CSC_LINK=
# The .p12 export password, not an Apple account password. An explicit empty value means an unencrypted .p12.
CSC_KEY_PASSWORD=

# ── Notarization (required for signed builds unless --skip-notarization) ───
# Choose exactly one strategy; leave the other two commented out.
# App Store Connect API key:
# APPLE_API_KEY=
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=
# Apple ID with an app-specific password:
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
# notarytool keychain profile (created with `xcrun notarytool store-credentials`):
# APPLE_KEYCHAIN_PROFILE=
# APPLE_KEYCHAIN=
